{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Map: dev server with watcher",
      "type": "debugpy",
      "request": "launch",
      "module": "rental_lookup.webmap.dev",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
