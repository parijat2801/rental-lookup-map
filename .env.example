# Copy to .env (gitignored) and fill in. Every value is optional.

# CARTO basemap key for the map tiles; without it the map uses Esri's keyless tiles.
CARTO_BASEMAPS_KEY=

# Apify API token for 99acres (themineworks/99acres-scraper). When set, fetch
# prefers Apify over the JSON API / Chrome SSR. ~$0.002 per listing returned.
# APIFY_TOKEN=
# Optional cap (default = max_pages * 30). Actor hard-caps at 2000 per run.
# APIFY_MAX_RESULTS=2000
