# Copy to .env (gitignored) and fill in. Every value is optional.

# CARTO basemap key for the map tiles; without it the map uses Esri's keyless tiles.
CARTO_BASEMAPS_KEY=

# OPENROUTER_API_KEY is read from the environment only (not from this file):
# OPENROUTER_API_KEY=... python -m rental_lookup.enrichment.photo_ratings 50
